{
  "name": "dyknow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build --workspace=packages/vscode-extension",
    "demo:smoke": "node packages/cli/dist/bin.js demo-smoke",
    "format": "biome format . --write",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "graphify": "python -m graphifyy ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
