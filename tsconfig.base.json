{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "baseUrl": ".",
    "paths": {
      "@dyknow/app": ["packages/app/src/index.ts"],
      "@dyknow/cloud-api": ["packages/cloud-api/src/server.ts"],
      "@dyknow/cloud-shared": ["packages/cloud-shared/src/index.ts"],
      "@dyknow/core": ["packages/core/src/index.ts"]
    }
  }
}
